{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "toargv",
  "scopeName": "source.toargv",
  "fileTypes": [
    "toargv"
  ],
  "uuid": "7c3e9a12-4b8f-4d61-9e20-a1f0c8b6d4e7",
  "information_for_contributors": [
    "TextMate grammar for toargv inline grammars ([OPTION SPEC PATH] / <SPEC PATH>).",
    "Language id: toargv. Associate *.toargv, or set the language mode manually.",
    "This file does not install highlighting by itself; an editor extension must contribute it."
  ],
  "patterns": [
    {
      "include": "#named-rule"
    },
    {
      "include": "#positional-rule"
    },
    {
      "name": "invalid.illegal.unexpected.toargv",
      "match": "[^\\s\\[<]+"
    }
  ],
  "repository": {
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.toargv",
          "match": "\\\\(?:[ \\\\tnr\\[\\]<>]|u\\{(?=[0-9A-Fa-f]{1,6}\\})0*(?:[0-9A-Fa-f]{1,3}|[0-9A-Ca-cE-Fe-f][0-9A-Fa-f]{3}|[dD][0-7][0-9A-Fa-f]{2}|[1-9A-Fa-f][0-9A-Fa-f]{4}|10[0-9A-Fa-f]{4})\\})"
        },
        {
          "name": "invalid.illegal.escape.toargv",
          "match": "\\\\u\\{[^}]*\\}?|\\\\.?"
        }
      ]
    },
    "named-rule": {
      "name": "meta.rule.named.toargv",
      "begin": "\\[",
      "end": "\\]",
      "applyEndPatternLast": true,
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.rule.begin.toargv"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.rule.end.toargv"
        }
      },
      "patterns": [
        {
          "include": "#named-contents"
        },
        {
          "include": "#escape"
        },
        {
          "name": "invalid.illegal.rule.toargv",
          "match": "[^\\]]+"
        }
      ]
    },
    "named-contents": {
      "patterns": [
        {
          "comment": "[OPTION !SPEC PATH] or [OPTION ! PATH]",
          "match": "\\G\\s*(-(?:\\\\.|[^\\s\\]\\\\=])+)\\s+(!)((?:auto|value|repeat|flag|count|a|v|r|f|c|(?:join=|j=)(?:\\\\.|[^\\s\\]\\\\])*))?\\s+((?:\\\\.|[^\\s\\]\\\\])+)\\s*",
          "captures": {
            "1": {
              "name": "entity.name.function.option.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            },
            "2": {
              "name": "keyword.operator.required.toargv"
            },
            "3": {
              "name": "keyword.other.action.toargv",
              "patterns": [
                {
                  "include": "#join-separator"
                }
              ]
            },
            "4": {
              "name": "variable.other.path.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            }
          }
        },
        {
          "comment": "[OPTION SPEC PATH]",
          "match": "\\G\\s*(-(?:\\\\.|[^\\s\\]\\\\=])+)\\s+((?:auto|value|repeat|flag|count|a|v|r|f|c|(?:join=|j=)(?:\\\\.|[^\\s\\]\\\\])*))\\s+((?:\\\\.|[^\\s\\]\\\\])+)\\s*",
          "captures": {
            "1": {
              "name": "entity.name.function.option.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            },
            "2": {
              "name": "keyword.other.action.toargv",
              "patterns": [
                {
                  "include": "#join-separator"
                }
              ]
            },
            "3": {
              "name": "variable.other.path.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            }
          }
        },
        {
          "comment": "[OPTION UNKNOWN PATH] \u2014 three tokens but the specifier is not a known action",
          "match": "\\G\\s*(-(?:\\\\.|[^\\s\\]\\\\=])+)\\s+((?:\\\\.|[^\\s\\]\\\\])+)\\s+((?:\\\\.|[^\\s\\]\\\\])+)\\s*",
          "captures": {
            "1": {
              "name": "entity.name.function.option.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            },
            "2": {
              "name": "invalid.illegal.action.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            },
            "3": {
              "name": "variable.other.path.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            }
          }
        },
        {
          "comment": "[OPTION PATH]",
          "match": "\\G\\s*(-(?:\\\\.|[^\\s\\]\\\\=])+)\\s+((?:\\\\.|[^\\s\\]\\\\])+)\\s*",
          "captures": {
            "1": {
              "name": "entity.name.function.option.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            },
            "2": {
              "name": "variable.other.path.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            }
          }
        }
      ]
    },
    "positional-rule": {
      "name": "meta.rule.positional.toargv",
      "begin": "<",
      "end": ">",
      "applyEndPatternLast": true,
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.rule.begin.toargv"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.rule.end.toargv"
        }
      },
      "patterns": [
        {
          "include": "#positional-contents"
        },
        {
          "include": "#escape"
        },
        {
          "name": "invalid.illegal.rule.toargv",
          "match": "[^>]+"
        }
      ]
    },
    "positional-contents": {
      "patterns": [
        {
          "comment": "<f PATH>, <c PATH>, and <!SPEC PATH> are parse errors",
          "match": "\\G\\s*((?:flag|count|f|c|!\\S*))\\s+((?:\\\\.|[^\\s>\\\\])+)\\s*",
          "captures": {
            "1": {
              "name": "invalid.illegal.action.toargv"
            },
            "2": {
              "name": "variable.other.path.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            }
          }
        },
        {
          "comment": "<SPEC PATH>",
          "match": "\\G\\s*((?:auto|value|repeat|a|v|r|(?:join=|j=)(?:\\\\.|[^\\s>\\\\])*))\\s+((?:\\\\.|[^\\s>\\\\])+)\\s*",
          "captures": {
            "1": {
              "name": "keyword.other.action.toargv",
              "patterns": [
                {
                  "include": "#join-separator"
                }
              ]
            },
            "2": {
              "name": "variable.other.path.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            }
          }
        },
        {
          "comment": "<UNKNOWN PATH> — two tokens but the specifier is not a known positional action",
          "match": "\\G\\s*((?:\\\\.|[^\\s>\\\\])+)\\s+((?:\\\\.|[^\\s>\\\\])+)\\s*",
          "captures": {
            "1": {
              "name": "invalid.illegal.action.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            },
            "2": {
              "name": "variable.other.path.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            }
          }
        },
        {
          "comment": "<PATH>",
          "match": "\\G\\s*((?:\\\\.|[^\\s>\\\\])+)\\s*",
          "captures": {
            "1": {
              "name": "variable.other.path.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            }
          }
        }
      ]
    },
    "join-separator": {
      "patterns": [
        {
          "match": "(?:j=|join=)(.*)",
          "captures": {
            "1": {
              "name": "string.unquoted.separator.toargv",
              "patterns": [
                {
                  "include": "#escape"
                }
              ]
            }
          }
        },
        {
          "include": "#escape"
        }
      ]
    }
  }
}
